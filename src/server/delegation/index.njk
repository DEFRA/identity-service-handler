{% extends 'layouts/page.njk' %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  <a href="/account" class="govuk-back-link">Back</a>
  {% if flash.removed %}
    {{ govukNotificationBanner({
      type: "success",
      html: "<h3 class=\"govuk-notification-banner__heading\">Delegate access removed</h3><p class=\"govuk-body\">Access has been removed for " + flash.email + "</p>"
    }) }}
  {% endif %}

  {{ appHeading({
    text: heading
  }) }}

  <p class="govuk-body">Add or remove people who can manage your holdings on your behalf.</p>
  <p class="govuk-body">Once removed, a delegate will no longer be able to manage your holdings.</p>


  {% if cphCount == 0 %}
    <p class="govuk-body">You do not have any County Parish Holdings assigned. You must claim your holdings before you can delegate access to them.</p>
  {% else %}
    {% if delegates.length %}
      <table class="govuk-table app-delegation-list">
        <caption class="govuk-visually-hidden">Delegates and available actions</caption>
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header app-delegation-list__email">Email address</th>
            <th scope="col" class="govuk-table__header app-delegation-list__action"><span class="govuk-visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          {% for delegate in delegates %}
            <tr class="govuk-table__row">
              <td class="govuk-table__cell app-delegation-list__email">{{ delegate.email }}</td>
              <td class="govuk-table__cell app-delegation-list__action">
                {% if cphCount == 1 %}
                  <a class="govuk-link app-delegation-list__remove-link" href="/account/delegations/{{ delegate.id }}/delete">
                    Remove<span class="govuk-visually-hidden"> {{ delegate.name }}</span>
                  </a>
                {% else %}
                  <a class="govuk-link app-delegation-list__remove-link" href="/account/delegations/{{ delegate.id }}/manage">
                    Manage<span class="govuk-visually-hidden"> {{ delegate.name }}</span>
                  </a>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <p class="govuk-body govuk-!-font-weight-bold app-delegation-list__summary">
        Showing {{ showingDelegatesCount }} out of {{ totalDelegatesCount }} delegates
      </p>

      {% if pagination %}
        {{ govukPagination(pagination) }}
      {% endif %}
    {% else %}
      <p class="govuk-body">You do not have any delegates yet.</p>
    {% endif %}

    <div class="govuk-button-group app-delegation-list__invite">
      {{ govukButton({
        text: "Add a new delegate",
        href: "/account/delegations/create"
      }) }}
    </div>
  {% endif %}

  <p class="govuk-body">
    <a class="govuk-link govuk-link--no-visited-state" href="#">Get help with this page</a>
  </p>
{% endblock %}
