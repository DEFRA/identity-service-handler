{% extends 'layouts/page.njk' %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <a href="/account/cphs" class="govuk-back-link">Back</a>

      {% if error %}
        <div class="govuk-error-summary" data-module="govuk-error-summary">
          <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
              <p class="govuk-body">{{ error }}</p>
            </div>
          </div>
        </div>
      {% endif %}

      {{ appHeading({
        text: heading
      }) }}

      <p class="govuk-body">{{ cphNumber }} ({{ ownerName }})</p>

      <form method="post" action="/account/cphs/{{ delegationId }}/remove">
        <input type="hidden" name="_csrf" value="{{ _csrf }}">
        {{ govukButton({
          text: "Continue"
        }) }}
      </form>

      <p class="govuk-body">
        <a href="/account/cphs" class="govuk-link">Cancel</a>
      </p>

    </div>
  </div>
{% endblock %}
